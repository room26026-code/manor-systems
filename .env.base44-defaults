# Base44 development placeholders. Listed FIRST in compose env_file entries so the
# platform-managed /run/base44/app.env (real secrets from the dashboard) always wins.
#
# TOKEN_ENCRYPTION_KEY encrypts Discord bot tokens at rest: a local dev key, replace
# it in production (hex encoded AES-256 key: `openssl enc -aes-256-cbc -k secret -P -md sha1`).
KITE_ENCRYPTION__TOKEN_ENCRYPTION_KEY=ff9bb3df78de595c6c0de5635101f3892e79e8f7025bf443709132db6078806d
# Discord OAuth application used for sign in — placeholder until real credentials are set.
KITE_DISCORD__CLIENT_ID=kite-base44-dev-placeholder
KITE_DISCORD__CLIENT_SECRET=kite-base44-dev-placeholder
